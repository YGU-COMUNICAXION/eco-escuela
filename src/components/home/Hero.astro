---
import { Image } from "astro:assets";
import banner from "@assets/imgs/banner2.jpg";
import graduates from "@assets/imgs/graduados-oratoria.png";
---

<section id="curso" class="bg-white">
  <div class="container mx-auto grid min-h-[calc(100vh-4rem)] items-center gap-10 px-6 py-14 lg:min-h-[calc(100vh-6rem)] lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:py-20">
    <div class="max-w-2xl">
      <span class="eco-eyebrow">Escuela de comunicacion y oratoria</span>
      <h1 class="mt-5 text-4xl font-black leading-[0.95] sm:text-5xl lg:text-6xl">
        Aprende a hablar en publico con claridad, presencia y autenticidad
      </h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-black/70 lg:text-lg">
        Cursos inmersivos, practica guiada y acompanamiento para comunicar tus ideas con mas seguridad.
      </p>
      <p class="mt-4 max-w-xl text-base font-bold italic leading-7 text-black/90 lg:text-lg">
        No es que no sepas hablar, es que nunca te ensenaron a sostener tu voz.
      </p>
      <div class="mt-9 flex w-full max-w-xl flex-col gap-4 sm:flex-row">
        <a class="eco-button eco-button-primary flex-1" href="#contacto">Inscribirme</a>
        <a class="eco-button eco-button-outline flex-1" href="#programas">Ver programas</a>
      </div>
    </div>

    <div class="hero-photos relative overflow-hidden rounded-lg shadow-[0_18px_60px_rgba(0,0,0,0.16)]">
      <Image
        src={banner}
        alt="Alumnos de ECO sosteniendo reconocimientos"
        class="block aspect-video w-full object-cover"
        widths={[480, 768, 1200]}
        sizes="(min-width: 1024px) 55vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <Image
        src={graduates}
        alt="Alumnos de ECO con sus certificados del curso Dominando la oratoria"
        class="hero-photo-next absolute inset-0 h-full w-full object-cover"
        widths={[480, 768, 1200]}
        sizes="(min-width: 1024px) 55vw, 100vw"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero-photo-next {
    opacity: 0;
    animation: photo-fade 12s ease-in-out infinite;
  }

  /* Each photo stays visible for five seconds, with one-second crossfades. */
  @keyframes photo-fade {
    0%, 41.667%, 100% { opacity: 0; }
    50%, 91.667% { opacity: 1; }
  }

  .hero-photos:hover .hero-photo-next {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo-next { animation: none; }
  }
</style>
