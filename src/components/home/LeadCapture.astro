<section id="contacto" class="relative z-10 bg-primary py-12 lg:py-14">
  <div class="container mx-auto px-6 text-center lg:px-8">
    <h2 class="text-2xl font-black lg:text-3xl">Se el primero en enterarte de los siguientes cursos</h2>
    <p class="mt-5 text-lg text-black/80">
      Deja tus datos y te avisaremos cuando abramos nuevas fechas.
    </p>

    <form class="mx-auto mt-6 grid max-w-md gap-4" aria-label="Formulario pendiente de conexion a Formspree">
      <input
        class="h-14 rounded border border-black/15 bg-white px-4 text-center text-lg outline-none focus:border-black"
        type="text"
        name="name"
        placeholder="Tu nombre"
        disabled
      />
      <input
        class="h-14 rounded border border-black/15 bg-white px-4 text-center text-lg outline-none focus:border-black"
        type="email"
        name="email"
        placeholder="Tu email"
        disabled
      />
      <button class="eco-button eco-button-dark w-full rounded" type="button" disabled>
        Avisarme
      </button>
    </form>
  </div>
</section>
