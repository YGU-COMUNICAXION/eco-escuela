---
import { courseCities, courseOffer, courseWhatsapp, formatPrice } from "../../data/courseSessions";
const topics = [
  "Presencia y lenguaje corporal",
  "Regulación y confianza",
  "Claridad y construcción del mensaje",
  "Comunicación asertiva en contextos reales",
  "Retroalimentación uno a uno",
];
---

<section id="fechas" aria-labelledby="fechas-title" class="eco-section relative overflow-hidden bg-[#151515] text-white">
  <div class="container relative mx-auto px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div>
        <span class="text-xs font-black uppercase tracking-[0.16em] text-primary">Curso intensivo · Presencial</span>
        <h2 id="fechas-title" class="mt-4 text-4xl font-black leading-[1.05] sm:text-5xl lg:text-6xl">
          Domina la oratoria.<br /><span class="text-primary">Elige tu fecha.</span>
        </h2>
      </div>
      <div class="max-w-sm lg:pb-1">
        <p class="text-lg leading-7 text-white/75">Comunica con más presencia, asertividad y confianza. Elige tu grupo en CDMX, Guadalajara o Monterrey.</p>
        <p class="mt-4 text-sm text-white/60">Impartido por <strong class="font-bold text-white">Yair Gittler</strong></p>
      </div>
    </div>

    <div class="mt-10 grid gap-5 lg:mt-12 lg:grid-cols-3">
      {courseCities.map(({ city, sessions }) => (
        <article class="date-card rounded-2xl bg-[#f7f7f5] p-6 text-[#151515] sm:p-8">
          <h3 class="text-3xl font-black">{city}</h3>
          <p class="mt-3 text-sm leading-6">Horario local. Consulta la sede por WhatsApp.</p>
          <ul class="mt-6 divide-y divide-black/15">
            {sessions.map((session) => (
              <li class="py-6 first:pt-0 last:pb-0">
                <p class="text-xl font-black leading-snug"><time datetime={session.start}>{session.dates}</time></p>
                <p class="mt-2 text-base leading-7">{session.hours}</p>
                <a class="eco-button eco-button-primary mt-4 w-full px-4 text-sm" href={courseWhatsapp(city, session.dates, session.hours)} target="_blank" rel="noopener noreferrer" aria-label={`Consultar disponibilidad por WhatsApp: ${city}, ${session.dates}, ${session.hours}`}>
                  Consultar disponibilidad
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-6 grid overflow-hidden rounded-2xl border border-white/20 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="bg-primary p-6 text-[#151515] sm:p-8 lg:p-10">
        <div data-course-offer data-ends-at={courseOffer.earlyBirdEndsAt}>
          <p data-early-bird class="text-sm font-black uppercase tracking-wide">Early bird hasta el {courseOffer.earlyBirdUntil}</p>
          <p class="mt-4 flex flex-wrap items-baseline gap-x-3">
            <del data-early-bird class="text-2xl font-bold text-black/60">{formatPrice(courseOffer.regularPrice)}</del>
            <span data-course-price class="text-5xl font-black tracking-tight" data-regular-price={formatPrice(courseOffer.regularPrice)}>{formatPrice(courseOffer.earlyBirdPrice)}</span>
            <span class="text-sm font-black">MXN</span>
          </p>
          <noscript><p class="mt-3 text-sm">Precio regular: {formatPrice(courseOffer.regularPrice)} MXN a partir del 1 de diciembre de 2026.</p></noscript>
        </div>
        <p class="mt-4 text-base leading-7">Incluye snacks y bebidas.</p>
        <div class="mt-6 border-t border-black/20 pt-5 text-base leading-7">
          <p class="font-black">Grupos de máximo {courseOffer.maxPeople} personas.</p>
          <p>Curso presencial en CDMX, Guadalajara y Monterrey.</p>
          <p class="mt-3">Consulta disponibilidad y sede por WhatsApp al elegir tu grupo.</p>
        </div>
      </div>
      <div class="p-6 sm:p-8 lg:p-10">
        <h3 class="text-2xl font-black">Práctica real. Sin fórmulas ni personajes.</h3>
        <p class="mt-3 max-w-xl text-sm leading-6 text-white/70">Encuentra comodidad, claridad y confianza al expresarte a tu manera. Durante el curso trabajaremos:</p>
        <ul class="mt-5 grid gap-x-6 gap-y-3 sm:grid-cols-2">
          {topics.map((topic) => (
            <li class="flex items-start gap-3 text-sm leading-6"><span class="text-primary" aria-hidden="true">↗</span>{topic}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  #fechas { scroll-margin-top: 6rem; }
  #fechas a:focus-visible { outline: 3px solid #151515; outline-offset: 4px; }
  .date-card { border-top: 4px solid var(--color-primary); }
  @media (prefers-reduced-motion: reduce) {
    #fechas a { transition: none; }
    #fechas a:hover { transform: none; }
  }
</style>

<script>
  const updateCourseOffer = () => {
    document.querySelectorAll<HTMLElement>("[data-course-offer]").forEach((offer) => {
      const deadline = Date.parse(offer.dataset.endsAt ?? "");
      if (Date.now() < deadline || !Number.isFinite(deadline)) return;
      offer.querySelectorAll<HTMLElement>("[data-early-bird]").forEach((item) => { item.hidden = true; });
      const price = offer.querySelector<HTMLElement>("[data-course-price]");
      if (price) price.textContent = price.dataset.regularPrice ?? "";
    });
  };
  document.addEventListener("astro:page-load", updateCourseOffer);
  document.addEventListener("visibilitychange", updateCourseOffer);
  setInterval(updateCourseOffer, 60_000);
</script>
