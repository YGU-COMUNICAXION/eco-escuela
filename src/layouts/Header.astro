---
import { Image } from "astro:assets";

import imgLogo from "@assets/svgs/logo.svg";

const isHome = Astro.url.pathname === "/";
const homeHref = isHome ? "#top" : "/";
const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header
  id="header"
  data-scrolled="false"
  class:list={[
    "group/header fixed left-0 right-0 z-20 flex items-center justify-center",
    "border-b border-black/5 bg-[#F5F5F5] transition-colors duration-300",
  ]}
>
  <div class="container relative mx-auto flex h-16 items-center justify-center px-6 lg:h-20 lg:justify-between lg:px-8">
    <button
      id="menu-toggle"
      class="absolute left-6 inline-flex size-10 items-center justify-center lg:hidden"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="navigator-menu"
    >
      <!-- Bars3Icon -->
      <svg
        id="menu-icon"
        data-header-icon
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-7 transition-colors duration-300"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
      </svg>
      <!-- XMarkIcon -->
      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="hidden size-7"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div
      class="flex w-full items-center justify-center lg:w-auto lg:justify-start"
    >
      <a
        href={homeHref}
        data-i18n-path="/"
        data-header-brand
        class={`flex items-center transition-colors duration-300`}
      >
        <Image class="h-8 w-auto lg:h-9" src={imgLogo} alt={"ECO"} />
      </a>
    </div>

    <nav
      id="navigator-menu"
      class:list={[
        "absolute left-0 right-0 top-full hidden bg-[#F5F5F5] lg:static lg:flex lg:bg-transparent",
        "border-b border-black/5 px-6 py-7 shadow lg:border-0 lg:p-0 lg:shadow-none",
        "justify-center lg:flex-1 lg:items-center lg:justify-end",
      ]}
    >
      <ul
        data-header-nav
        class={`h-full
        mx-auto flex w-full flex-col items-center justify-center gap-5 text-center lg:w-auto lg:flex-row lg:items-center lg:justify-end lg:gap-7 lg:text-right
        lg:[&>li]:text-center
        [&>li>a]:relative [&>li>a]:uppercase [&>li]:inline-block
        [&>li>a]:hover:underline [&>li>a]:transition-colors [&>li>a]:duration-300
        [&>li>a]:ease-in-out
        font-normal text-sm transition-colors duration-300 lg:text-base
      `}
      >
        <li>
          <a href={homeHref}> Inicio </a>
        </li>
        <li>
          <a href={sectionHref("que-es-eco")}> Curso de oratoria </a>
        </li>
        <li>
          <a href={sectionHref("programas")}> Programas </a>
        </li>
        <li>
          <a href={sectionHref("empresas")}> Empresa </a>
        </li>
        <li>
          <a href={sectionHref("contacto")}> Contactos </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  @reference "../styles/global.css";

  /* Colocar linea color roja del link activo por debajo del link, pero en desktop colocar la linea encima del link */
  #navigator-menu a:is(.active) {
    font-weight: 600;
  }

  .header-logo {
    @apply h-8 md:h-12 w-auto;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
    const barsIcon = document.querySelector<SVGElement>("#menu-icon");
    const closeIcon = document.querySelector<SVGElement>("#close-icon");
    const navigatorMenu = document.querySelector<HTMLElement>("#navigator-menu");
    const header = document.querySelector<HTMLElement>("#header");

    if (!navigatorMenu || !barsIcon || !closeIcon || !header || !menuToggle) {
      throw new Error("Element not found");
    }

    const setMenuOpen = (open: boolean | undefined) => {
      barsIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      navigatorMenu.classList.toggle("hidden", !open);
      navigatorMenu.classList.toggle("flex", open);
      header.setAttribute("data-menu-open", open ? "true" : "false");
      menuToggle.setAttribute("aria-expanded", open ? "true" : "false");
    };

    setMenuOpen(false);

    menuToggle.addEventListener("click", () => {
      const isOpen = header.getAttribute("data-menu-open") === "true";
      setMenuOpen(!isOpen);
    });

    navigatorMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });
  });
</script>
